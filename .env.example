# Token budget limit for recent messages rolling window
TOKEN_BUDGET_LIMIT=4000

# LLM Provider Choice: "openai" or "groq" (Optional, auto-detected if keys are set)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq Configuration (Fast Open-Source Models)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
